# PROV-O export of a provenance Tracker graph, using the
# data-labour-prov vocabulary.
# Generated by github.com/dayvidpham/provenance/pkg/provo — deterministic, pure read.
#
# NOTE (role granularity): prov:hadRole is synthesized at AGENT level from
#   MLAgent.Role. Until the qualified-association layer lands,
#   role is a property of the acting ML agent, not of the specific act; only
#   ML-agent activities are typed p-plan:Activity (they can furnish the required
#   agent+role association per the AnnotationActShape).
# NOTE (:derivationKind): NOT emitted here. Qualified
#   derivation nodes carry the fact of derivation and its time, but no typed reason.
# NOTE (namespace): the ':' vocabulary namespace <https://example.org/data-labour-prov#> is a PLACEHOLDER pending w3id registration.

@prefix :      <https://example.org/data-labour-prov#> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix pplan: <http://purl.org/net/p-plan#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# Built-in plan: the 13-value Phase enum reified as p-plan:Step-per-phase.
<urn:provenance:plan/pasture-12-phase> a pplan:Plan ;
    rdfs:label "pasture-12-phase" .
<urn:provenance:plan/pasture-12-phase/step/request> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "request" .
<urn:provenance:plan/pasture-12-phase/step/elicit> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "elicit" .
<urn:provenance:plan/pasture-12-phase/step/propose> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "propose" .
<urn:provenance:plan/pasture-12-phase/step/review> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "review" .
<urn:provenance:plan/pasture-12-phase/step/plan_uat> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "plan_uat" .
<urn:provenance:plan/pasture-12-phase/step/ratify> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "ratify" .
<urn:provenance:plan/pasture-12-phase/step/handoff> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "handoff" .
<urn:provenance:plan/pasture-12-phase/step/impl_plan> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "impl_plan" .
<urn:provenance:plan/pasture-12-phase/step/worker_slices> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "worker_slices" .
<urn:provenance:plan/pasture-12-phase/step/code_review> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "code_review" .
<urn:provenance:plan/pasture-12-phase/step/impl_uat> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "impl_uat" .
<urn:provenance:plan/pasture-12-phase/step/landing> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "landing" .
<urn:provenance:plan/pasture-12-phase/step/unscoped> a pplan:Step ;
    pplan:isStepOfPlan <urn:provenance:plan/pasture-12-phase> ;
    rdfs:label "unscoped" .

# Agents (prov:Person / prov:SoftwareAgent / :LLMAgent).
<urn:provenance:provo--agent-system> a prov:SoftwareAgent ;
    rdfs:label "pasture-system" .
<urn:provenance:provo--agent-human> a prov:Person ;
    rdfs:label "Ada Lovelace" .
<urn:provenance:provo--agent-software> a prov:SoftwareAgent ;
    rdfs:label "pasture-cli" .
<urn:provenance:provo--agent-ml> a :LLMAgent ;
    :modelId "anthropic/claude-opus-4-6" ;
    rdfs:label "claude-opus-4-6" .

# Activities (prov:Activity; ML-agent acts also p-plan:Activity).
<urn:provenance:provo--act-ml> a prov:Activity, pplan:Activity ;
    prov:startedAtTime "TIMESTAMP"^^xsd:dateTime ;
    prov:endedAtTime "TIMESTAMP"^^xsd:dateTime ;
    pplan:correspondsToStep <urn:provenance:plan/pasture-12-phase/step/propose> ;
    prov:wasAssociatedWith <urn:provenance:provo--agent-ml> ;
    prov:qualifiedAssociation [
        a prov:Association ;
        prov:agent <urn:provenance:provo--agent-ml> ;
        prov:hadRole "worker"
    ] ;
    rdfs:comment "drafting the proposal" .
<urn:provenance:provo--act-human> a prov:Activity ;
    prov:startedAtTime "TIMESTAMP"^^xsd:dateTime ;
    pplan:correspondsToStep <urn:provenance:plan/pasture-12-phase/step/review> ;
    prov:wasAssociatedWith <urn:provenance:provo--agent-human> ;
    rdfs:comment "review pass" .

# Entities (prov:Entity) and their provenance edges.
<urn:provenance:provo--task-request> a prov:Entity ;
    rdfs:label "REQUEST: PROV-O export" ;
    rdfs:comment "the \"request\" body\nwith a newline and a snowman ☃" .
<urn:provenance:provo--task-request> prov:wasGeneratedBy <urn:provenance:provo--act-ml> .
<urn:provenance:provo--task-request> prov:wasAttributedTo <urn:provenance:provo--agent-ml> .
<urn:provenance:provo--task-proposal-1> a prov:Entity ;
    rdfs:label "PROPOSAL-1" ;
    rdfs:comment "first proposal" .
<urn:provenance:provo--task-proposal-1> prov:wasDerivedFrom <urn:provenance:provo--task-request> ;
    prov:qualifiedDerivation [
        a prov:Derivation ;
        prov:entity <urn:provenance:provo--task-request> ;
        prov:atTime "TIMESTAMP"^^xsd:dateTime
    ] .
<urn:provenance:provo--task-proposal-2> a prov:Entity ;
    rdfs:label "PROPOSAL-2" ;
    rdfs:comment "revised proposal" .
<urn:provenance:provo--task-proposal-2> prov:wasRevisionOf <urn:provenance:provo--task-proposal-1> ;
    prov:qualifiedDerivation [
        a prov:Derivation ;
        prov:entity <urn:provenance:provo--task-proposal-1> ;
        prov:atTime "TIMESTAMP"^^xsd:dateTime
    ] .
<urn:provenance:provo--task-bug> a prov:Entity ;
    rdfs:label "BUG: escaping" .
<urn:provenance:provo--task-bug> prov:wasInfluencedBy <urn:provenance:provo--task-proposal-1> .
